[Application]
app.classpath=$APPDIR/SimAS.jar
app.mainclass=bienvenida.Bienvenida
app.classpath=$APPDIR/javafx/itextpdf-5.5.13.3.jar
app.classpath=$APPDIR/javafx/javafx-swt.jar
app.classpath=$APPDIR/javafx/javafx.base.jar
app.classpath=$APPDIR/javafx/javafx.controls.jar
app.classpath=$APPDIR/javafx/javafx.fxml.jar
app.classpath=$APPDIR/javafx/javafx.graphics.jar
app.classpath=$APPDIR/javafx/javafx.media.jar
app.classpath=$APPDIR/javafx/javafx.swing.jar
app.classpath=$APPDIR/javafx/javafx.web.jar

[JavaOptions]
java-options=-Djpackage.app-version=1.0
java-options=--module-path
java-options=apps/macos/input/javafx
java-options=--add-modules
java-options=javafx.controls,javafx.fxml,javafx.graphics,javafx.web
