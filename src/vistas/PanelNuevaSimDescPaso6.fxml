<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css" style="-fx-background-color: #263445;">
    <top>
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="labelTitulo" text="%simulador.paso6.titulo" styleClass="wizard-header" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, #00000088, 2, 0.5, 0, 1); -fx-padding: 18 0 10 0;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" alignment="TOP_CENTER" style="-fx-padding: 10 30 10 30;">
            <HBox spacing="30" alignment="CENTER">
                <VBox spacing="7" alignment="TOP_LEFT" style="-fx-background-color: rgba(255,255,255,0.08); -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16;" prefWidth="340">
                    <Label fx:id="labelProducciones" text="%simulador.paso6.producciones.titulo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 6 0;"/>
                    <ListView fx:id="listProducciones" prefHeight="180" style="-fx-background-color: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-text-fill: black;"/>
                </VBox>
                <VBox spacing="7" alignment="TOP_LEFT" style="-fx-background-color: rgba(255,255,255,0.08); -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16;" prefWidth="340">
                    <Label fx:id="labelFuncionesError" text="%simulador.paso6.funciones.error.titulo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 6 0;"/>
                    <ListView fx:id="listFuncionesError" prefHeight="180" style="-fx-background-color: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-text-fill: black;"/>
                </VBox>
            </HBox>
            <Label fx:id="labelTabla" text="%simulador.paso6.tabla.titulo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10 0 0 0;"/>
            <TableView fx:id="tablePredictiva" prefHeight="300" prefWidth="700" styleClass="wizard-table" style="-fx-background-color: white; -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px;"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="25" alignment="CENTER" style="-fx-padding: 18 0 18 0;">
            <Button fx:id="btnSimular" text="%simulador.paso6.btn.simular" styleClass="button" style="-fx-font-size: 15px; -fx-pref-width: 180; -fx-pref-height: 40; -fx-background-color: #2d8cf0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" onAction="#iniciarSimulacion"/>
            <Button fx:id="btnModificarErrores" text="%simulador.paso6.btn.modificar.errores" styleClass="button" style="-fx-font-size: 15px; -fx-pref-width: 180; -fx-pref-height: 40; -fx-background-color: #19be6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" onAction="#modificarErrores"/>
            <Button fx:id="btnGenerarInforme" text="%simulador.paso6.btn.generar.informe" styleClass="button" style="-fx-font-size: 15px; -fx-pref-width: 180; -fx-pref-height: 40; -fx-background-color: #ff9900; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" onAction="#generarInforme"/>
        </HBox>
    </bottom>
</BorderPane>
