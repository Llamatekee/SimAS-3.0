<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="20" alignment="TOP_CENTER" styleClass="wizard-content">
    <padding>
        <Insets top="20" right="40" bottom="30" left="40"/>
    </padding>

    <Label fx:id="labelTitulo" text="Nueva Función de Error" styleClass="wizard-header">
        <VBox.margin>
            <Insets bottom="10"/>
        </VBox.margin>
    </Label>

    <GridPane vgap="15" hgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints minWidth="250" prefWidth="250" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label fx:id="labelIdentificador" text="Identificador" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="textFieldIdentificador" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label fx:id="labelAccion" text="Acción" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboBoxAccion" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label fx:id="labelSimbolo" text="Símbolo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboBoxSimbolo" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label fx:id="labelMensaje" text="Mensaje" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="textFieldMensaje" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="buttonAceptar" text="Aceptar" onAction="#handleAceptar" styleClass="button-finish"/>
        <Button fx:id="buttonCancelar" text="Cancelar" onAction="#handleCancelar" styleClass="button-cancel"/>
    </HBox>
</VBox>